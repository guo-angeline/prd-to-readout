# prd-to-readout talks to any LLM provider via LiteLLM.
# Set the key for whichever provider you point P2R_MODEL at, then copy this to .env.

# --- Anthropic (default) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI ---
# OPENAI_API_KEY=sk-...

# --- Local Ollama (no key needed) ---
# point P2R_MODEL at e.g. "ollama/llama3.1" and run `ollama serve`

# Which model to use. Any LiteLLM-supported model string works.
# Examples: claude-sonnet-4-6, gpt-4o, ollama/llama3.1
P2R_MODEL=claude-sonnet-4-6

# Seed for reproducible mock-data generation (keeps the demo deterministic).
P2R_SEED=42

# --- Notifications (optional) ---
# Handoffs at each gate also fire to these channels if configured. Console always echoes.
# Slack incoming webhook:
# P2R_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# Email (SMTP):
# P2R_SMTP_HOST=smtp.gmail.com
# P2R_SMTP_PORT=587
# P2R_SMTP_USER=you@example.com
# P2R_SMTP_PASSWORD=app-password
# P2R_EMAIL_FROM=you@example.com
# P2R_EMAIL_TO=engineer@example.com

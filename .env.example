# prd-to-readout settings. Copy this to `.env` (or run `prd-to-readout init`). Keep it private.
#
# ============================================================
#  STEP 1 (required): pick a model and paste a key
# ============================================================
# prd-to-readout uses an AI model to read your PRD. Choose ONE option.
#
# --- Option A: Claude (recommended) -------------------------
#   Get a key: https://console.anthropic.com/settings/keys
#   Paste it after the = sign below (no quotes, no spaces).
ANTHROPIC_API_KEY=
P2R_MODEL=claude-sonnet-4-6
#
# --- Option B: OpenAI ---------------------------------------
#   Get a key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# P2R_MODEL=gpt-4o
#
# --- Option C: Free, runs on your computer ------------------
#   No key, no internet, lower quality. Install https://ollama.com,
#   then run: ollama pull llama3.1
# P2R_MODEL=ollama/llama3.1
#
# Seed for reproducible simulated previews.
P2R_SEED=42
#
# ============================================================
#  STEP 2 (optional): send approval handoffs to Slack / email
# ============================================================
# P2R_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# P2R_SMTP_HOST=smtp.gmail.com
# P2R_SMTP_PORT=587
# P2R_SMTP_USER=you@example.com
# P2R_SMTP_PASSWORD=app-password
# P2R_EMAIL_FROM=you@example.com
# P2R_EMAIL_TO=engineer@example.com
